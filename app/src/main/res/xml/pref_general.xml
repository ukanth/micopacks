<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ListPreference
        android:defaultValue="system"
        android:entries="@array/theme_mode_entries"
        android:entryValues="@array/theme_mode_values"
        android:key="theme_mode"
        android:title="@string/theme_mode"
        app:iconSpaceReserved="false"
        app:useSimpleSummaryProvider="true" />
    <!-- shown on Android 12+ only (SettingsActivity) -->
    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="dynamic_color"
        android:summary="@string/dynamic_color_summary"
        android:title="@string/dynamic_color"
        app:iconSpaceReserved="false"
        app:isPreferenceVisible="false" />
    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="notify_install"
        android:title="@string/show_notification"
        app:iconSpaceReserved="false" />


    <PreferenceCategory
        android:title="@string/pref_packs_list"
        app:iconSpaceReserved="false">

        <ListPreference
            android:defaultValue="apply"
            android:entries="@array/swipe_action_entries"
            android:entryValues="@array/swipe_action_values"
            android:key="swipe_right"
            android:title="@string/pref_swipe_right"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="favorite"
            android:entries="@array/swipe_action_entries"
            android:entryValues="@array/swipe_action_values"
            android:key="swipe_left"
            android:title="@string/pref_swipe_left"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="show_favorites"
            android:title="@string/pref_favorites_first"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>


    <PreferenceCategory
        android:title="Others"
        app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="enable_auto_theming"
            android:summary="@string/enable_auto_theming_summary"
            android:title="@string/enable_auto_theming"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:defaultValue="5"
            android:entries="@array/col"
            android:entryValues="@array/colvalue"
            android:key="preview_col"
            android:title="Number of Columns in Preview"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="Misc"
        app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="use_root_tasker"
            android:title="@string/use_root"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="use_launcher_menu"
            android:title="@string/use_launcher_menu"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>


</PreferenceScreen>
